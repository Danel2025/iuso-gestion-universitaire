# Variables lues par les outils (Vite, Wrangler, drizzle-kit) : copier vers .env (jamais commité).

# Base PostgreSQL locale utilisée par le binding HYPERDRIVE en développement.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://iuso:iuso@localhost:5432/iuso_dev

# Connexion directe utilisée par drizzle-kit pour appliquer les migrations.
DATABASE_URL=postgres://iuso:iuso@localhost:5432/iuso_dev
