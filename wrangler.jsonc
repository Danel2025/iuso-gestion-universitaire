/**
 * Configuration Cloudflare Workers de la plateforme IUSO-SNE.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Trois environnements : développement local (racine de ce fichier),
 * `recette` et `production`. Les bindings ne s'héritent pas entre
 * environnements Wrangler : chaque environnement les redéclare.
 * Choix de l'environnement au build : CLOUDFLARE_ENV=recette npm run build
 *
 * Les identifiants `<...>` sont à remplacer après création des ressources
 * (voir README, section « Mise en place Cloudflare »).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "iuso-sne",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	// Point d'entrée personnalisé : requêtes HTTP (TanStack Start) + consommateur de Queue + Cron.
	"main": "src/server.ts",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"vars": {
		"APP_ENV": "development",
		"APP_URL": "http://localhost:3000"
	},
	// En local, la chaîne de connexion vient de la variable d'environnement
	// CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (voir .env.example).
	"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-dev-id>" }],
	"r2_buckets": [{ "binding": "FICHIERS", "bucket_name": "iuso-fichiers-dev", "jurisdiction": "eu" }],
	"queues": {
		"producers": [{ "binding": "NOTIFICATIONS", "queue": "iuso-notifications-dev" }],
		"consumers": [{ "queue": "iuso-notifications-dev", "max_batch_size": 10, "max_retries": 5 }]
	},
	"env": {
		"recette": {
			"name": "iuso-sne-recette",
			"vars": {
				"APP_ENV": "recette",
				"APP_URL": "https://recette.iuso-sne.example"
			},
			"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-recette-id>" }],
			"r2_buckets": [{ "binding": "FICHIERS", "bucket_name": "iuso-fichiers-recette", "jurisdiction": "eu" }],
			"queues": {
				"producers": [{ "binding": "NOTIFICATIONS", "queue": "iuso-notifications-recette" }],
				"consumers": [{ "queue": "iuso-notifications-recette", "max_batch_size": 10, "max_retries": 5 }]
			},
			"triggers": { "crons": ["0 6 * * *"] }
		},
		"production": {
			"name": "iuso-sne",
			"vars": {
				"APP_ENV": "production",
				"APP_URL": "https://plateforme.iuso-sne.example"
			},
			"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-production-id>" }],
			"r2_buckets": [{ "binding": "FICHIERS", "bucket_name": "iuso-fichiers-production", "jurisdiction": "eu" }],
			"queues": {
				"producers": [{ "binding": "NOTIFICATIONS", "queue": "iuso-notifications-production" }],
				"consumers": [{ "queue": "iuso-notifications-production", "max_batch_size": 10, "max_retries": 5 }]
			},
			"triggers": { "crons": ["0 6 * * *"] }
		}
	}
}
